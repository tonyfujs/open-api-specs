    "schemas": {
      "SearchQuerySchema": {
        "type": "object",
        "properties": {
          "count": {
            "type": "boolean",
            "description": "When set to true, the response will include the total count of matching results.",
            "example": true
          },
          "filter": {
            "type": "string",
            "description": "An OData-style filter expression. Use slash-paths for nested fields and `any(t: ...)` for arrays. Example: `series_description/topics/any(t: t/name eq 'Infrastructure: Transportation')`.",
            "example": "series_description/topics/any(t: t/name eq 'Infrastructure: Transportation')"
          },
          "orderby": {
            "type": "string",
            "description": "Specifies the ordering of the results. Leave empty to apply default ordering.",
            "example": "series_description/name"
          },
          "select": {
            "type": "string",
            "description": "Comma-separated list of fields to include in the response. Use slash-paths for nested fields (e.g. `series_description/idno`). See `MetadataDocument` for the full list of accessible fields.",
            "example": "series_description/idno, series_description/name, series_description/database_id"
          },
          "searchFields": {
            "type": "string",
            "description": "Specifies which fields should be searched. Leave empty to search all available fields.",
            "example": "series_description/name"
          },
          "search": {
            "type": "string",
            "description": "The search term to be applied.",
            "example": "poverty"
          },
          "top": {
            "type": "integer",
            "format": "int32",
            "description": "The maximum number of results to return.",
            "example": 5
          },
          "skip": {
            "type": "integer",
            "format": "int32",
            "description": "The number of results to skip, useful for pagination.",
            "example": 0
          },
          "facets": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "vectorFilterModeSearch": {
            "type": "string",
            "nullable": true
          },
          "vectorQueries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VectorQueryModel"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Threshold": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "nullable": true
          },
          "value": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "VectorQueryModel": {
        "type": "object",
        "properties": {
          "vector": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "float"
            },
            "nullable": true
          },
          "fields": {
            "type": "string",
            "nullable": true
          },
          "kind": {
            "type": "string",
            "nullable": true
          },
          "k": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "weight": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "threshold": {
            "$ref": "#/components/schemas/Threshold"
          }
        },
        "additionalProperties": false
      },
      "DataResponse": {
        "type": "object",
        "description": "Envelope returned by `/data360/data`.",
        "properties": {
          "count": {
            "type": "integer",
            "description": "Total number of matching records."
          },
          "value": {
            "type": "array",
            "description": "Array of data observations.",
            "items": {
              "$ref": "#/components/schemas/DataObservation"
            }
          }
        },
        "additionalProperties": false
      },
      "DataObservation": {
        "type": "object",
        "description": "A single data observation (a row in the time series).",
        "properties": {
          "OBS_VALUE": { "type": "string", "description": "Observation value." },
          "TIME_FORMAT": { "type": "string", "description": "Time format, e.g., period (P1Y)." },
          "UNIT_MULT": { "type": "integer", "description": "Multiplier for the unit." },
          "COMMENT_OBS": { "type": "string", "nullable": true, "description": "Comment for the observation." },
          "OBS_STATUS": { "type": "string", "description": "Observation status." },
          "OBS_CONF": { "type": "string", "description": "Observation confidence." },
          "AGG_METHOD": { "type": "string", "description": "Aggregation method." },
          "DECIMALS": { "type": "string", "description": "Number of decimal places." },
          "COMMENT_TS": { "type": "string", "description": "Comment on the timeseries." },
          "DATA_SOURCE": { "type": "string", "description": "Identifier for the data source." },
          "LATEST_DATA": { "type": "boolean", "description": "Indicates if the data is the latest available." },
          "DATABASE_ID": { "type": "string", "description": "Identifier for the database." },
          "INDICATOR": { "type": "string", "description": "Identifier for the indicator." },
          "REF_AREA": { "type": "string", "description": "Reference area (e.g., country or region code)." },
          "SEX": { "type": "string", "description": "Sex of the subject." },
          "AGE": { "type": "string", "description": "Age group." },
          "URBANISATION": { "type": "string", "description": "Indicator of urbanisation." },
          "COMP_BREAKDOWN_1": { "type": "string", "description": "Composite breakdown dimension 1." },
          "COMP_BREAKDOWN_2": { "type": "string", "description": "Composite breakdown dimension 2." },
          "COMP_BREAKDOWN_3": { "type": "string", "description": "Composite breakdown dimension 3." },
          "TIME_PERIOD": { "type": "string", "description": "Time period of the observation." },
          "FREQ": { "type": "string", "description": "Frequency of the data." },
          "UNIT_MEASURE": { "type": "string", "description": "Unit of measure." },
          "UNIT_TYPE": { "type": "string", "nullable": true, "description": "Type of unit (if applicable)." }
        },
        "additionalProperties": false
      },
      "MetadataSearchResponse": {
        "type": "object",
        "description": "Envelope returned by `/data360/searchv2` and `/data360/metadata`. Follows the OData response shape.",
        "properties": {
          "@odata.context": {
            "type": "string",
            "description": "URI describing the metadata of the response."
          },
          "@odata.count": {
            "type": "integer",
            "description": "Total number of matching documents (returned when `count=true`)."
          },
          "value": {
            "type": "array",
            "description": "Array of metadata documents.",
            "items": {
              "$ref": "#/components/schemas/MetadataDocument"
            }
          }
        }
      },
      "MetadataDocument": {
        "type": "object",
        "description": "A single Data360 catalog document. The `type` field is the discriminator: `indicator`, `database`, `economy`, etc. This schema documents the `indicator` variant in full; other variants share the root fields but may populate different subsets of the namespaces.\n\nFields are organized into four namespaces plus root-level indexing fields:\n- root: indexing / discriminator fields\n- `metadata_information`: document-level metadata\n- `series_description`: descriptive metadata (the bulk of the content)\n- `additional`: visualization hints\n- `disaggregation_codes`: per-dimension codelist values",
        "properties": {
          "@search.score": {
            "type": "number",
            "format": "double",
            "description": "Relevance score assigned by the search engine (present on `/searchv2` responses)."
          },
          "id": { "type": "string", "description": "Internal document ID." },
          "idno": { "type": "string", "description": "Globally unique identifier (UUID) of the document." },
          "type": {
            "type": "string",
            "description": "Document type discriminator.",
            "enum": ["indicator", "database", "economy", "dataset", "topic", "source"]
          },
          "subtype": { "type": "string", "nullable": true, "description": "Document subtype (e.g. `timeseries`)." },
          "disaggregation_types": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Labels of the disaggregation dimensions available for this indicator."
          },
          "isDelete": { "type": "boolean", "nullable": true },
          "doc_type": { "type": "string", "nullable": true },
          "remove_chart_type": { "type": "string", "nullable": true, "description": "Comma-separated list of chart types that should not be offered for this indicator." },
          "data_confidentiality_code": { "type": "string", "nullable": true, "description": "Confidentiality code (e.g. `PU` for public)." },
          "data_confidentiality_name": { "type": "string", "nullable": true, "description": "Human-readable confidentiality label." },
          "dsd_name": { "type": "string", "nullable": true, "description": "Name of the data structure definition (e.g. `DATA360`)." },
          "dsd_version": { "type": "string", "nullable": true, "description": "Version of the DSD." },
          "dsd_codelist": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Codelists referenced by the DSD."
          },
          "is_active": { "type": "boolean", "nullable": true },
          "metadata_information": { "$ref": "#/components/schemas/MetadataInformation" },
          "series_description": { "$ref": "#/components/schemas/SeriesDescription" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "additional": { "$ref": "#/components/schemas/Additional" },
          "product": { "type": "string", "nullable": true },
          "disaggregation_codes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DisaggregationCode" },
            "description": "Codelist values for each disaggregation dimension."
          }
        }
      },
      "MetadataInformation": {
        "type": "object",
        "description": "Document-level metadata namespace.",
        "properties": {
          "title": { "type": "string", "nullable": true, "description": "Document title." },
          "idno": { "type": "string", "nullable": true, "description": "Identifier of the metadata record." },
          "prod_date": { "type": "string", "nullable": true, "description": "Production date." },
          "version_statement": { "$ref": "#/components/schemas/VersionStatement" },
          "producers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Producer" }
          }
        }
      },
      "VersionStatement": {
        "type": "object",
        "properties": {
          "version": { "type": "string", "nullable": true },
          "version_date": { "type": "string", "nullable": true },
          "version_resp": { "type": "string", "nullable": true, "description": "Person or entity responsible for this version." },
          "version_notes": { "type": "string", "nullable": true }
        }
      },
      "Producer": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "nullable": true },
          "abbr": { "type": "string", "nullable": true, "description": "Abbreviation of the producer's name." },
          "affiliation": { "type": "string", "nullable": true },
          "role": { "type": "string", "nullable": true }
        }
      },
      "SeriesDescription": {
        "type": "object",
        "description": "Descriptive metadata namespace. Contains the bulk of the human-readable metadata for an indicator: identifiers, definitions, methodology, references, sources, license, links, and per-indicator dimension/country/time-period catalogs.",
        "properties": {
          "idno": { "type": "string", "nullable": true, "description": "Indicator identifier (matches the `INDICATOR` filter on `/data360/data`)." },
          "doi": { "type": "string", "nullable": true, "description": "Digital Object Identifier." },
          "name": { "type": "string", "nullable": true, "description": "Indicator name." },
          "display_name": { "type": "string", "nullable": true },
          "database_id": { "type": "string", "nullable": true, "description": "Database identifier (matches the `DATABASE_ID` filter on `/data360/data`)." },
          "database_name": { "type": "string", "nullable": true },
          "date_last_update": { "type": "string", "nullable": true },
          "date_released": { "type": "string", "nullable": true },
          "measurement_unit": { "type": "string", "nullable": true },
          "release_calendar": { "type": "string", "nullable": true },
          "periodicity": { "type": "string", "nullable": true, "description": "E.g. `Annual`, `Quarterly`, `Monthly`, or a comma-separated combination." },
          "base_period": { "type": "string", "nullable": true },
          "definition_short": { "type": "string", "nullable": true },
          "definition_long": { "type": "string", "nullable": true },
          "statistical_concept": { "type": "string", "nullable": true },
          "methodology": { "type": "string", "nullable": true },
          "derivation": { "type": "string", "nullable": true },
          "imputation": { "type": "string", "nullable": true },
          "missing": { "type": "string", "nullable": true },
          "quality_checks": { "type": "string", "nullable": true },
          "quality_note": { "type": "string", "nullable": true },
          "sources_discrepancies": { "type": "string", "nullable": true },
          "series_break": { "type": "string", "nullable": true },
          "limitation": { "type": "string", "nullable": true },
          "relevance": { "type": "string", "nullable": true },
          "aggregation_method": { "type": "string", "nullable": true },
          "disaggregation": { "type": "string", "nullable": true },
          "confidentiality": { "type": "string", "nullable": true },
          "confidentiality_status": { "type": "string", "nullable": true },
          "confidentiality_note": { "type": "string", "nullable": true },
          "citation_requirement": { "type": "string", "nullable": true },
          "sources_note": { "type": "string", "nullable": true },
          "acknowledgement_statement": { "type": "string", "nullable": true },
          "disclaimer": { "type": "string", "nullable": true },
          "economies_count": { "type": "integer", "nullable": true },
          "csv_link": { "type": "string", "nullable": true, "description": "Direct URL to the CSV data file." },
          "excel_link": { "type": "string", "nullable": true },
          "json_link": { "type": "string", "nullable": true, "description": "Direct URL to the JSON metadata file." },
          "api_link": { "type": "string", "nullable": true, "description": "Pre-built `/data360/data` API URL for this indicator." },
          "indicator_count": { "type": "integer", "nullable": true },
          "api_explorer_link": { "type": "string", "nullable": true },
          "remove_chart_type": { "type": "string", "nullable": true },
          "authoring_entity": {
            "type": "array",
            "items": { "type": "object" }
          },
          "version_statement": { "$ref": "#/components/schemas/VersionStatement" },
          "aliases": {
            "type": "array",
            "items": { "type": "object" }
          },
          "alternate_identifiers": {
            "type": "array",
            "items": { "type": "object" }
          },
          "languages": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Language" }
          },
          "dimensions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Dimension" },
            "description": "Dimensions along which the indicator is disaggregated."
          },
          "definition_references": { "type": "array", "items": { "type": "object" } },
          "statistical_concept_references": { "type": "array", "items": { "type": "object" } },
          "methodology_references": { "type": "array", "items": { "type": "object" } },
          "derivation_references": { "type": "array", "items": { "type": "object" } },
          "imputation_references": { "type": "array", "items": { "type": "object" } },
          "topics": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Topic" },
            "description": "Topics the indicator belongs to (across multiple vocabularies / hierarchies)."
          },
          "time_periods": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TimePeriod" }
          },
          "ref_country": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RefArea" },
            "description": "Reference areas (countries/economies) for which the indicator has data."
          },
          "geographic_units": {
            "type": "array",
            "items": { "type": "object" }
          },
          "aggregation_method_references": {
            "type": "array",
            "items": { "type": "object" }
          },
          "license": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/License" }
          },
          "links": {
            "type": "array",
            "items": { "type": "object" }
          },
          "api_documentation": {
            "type": "array",
            "items": { "type": "object" }
          },
          "sources": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Source" }
          },
          "notes": {
            "type": "array",
            "items": { "type": "object" }
          },
          "related_indicators": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      },
      "Language": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Language name (e.g. `English`)." },
          "code": { "type": "string", "description": "Language code (e.g. `EN`)." }
        }
      },
      "Dimension": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "nullable": true },
          "label": { "type": "string", "nullable": true, "description": "Human-readable dimension label." },
          "description": { "type": "string", "nullable": true }
        }
      },
      "Topic": {
        "type": "object",
        "description": "A topic classification entry. Topics can be hierarchical via `parent_id`, and the same indicator can be classified in multiple vocabularies.",
        "properties": {
          "id": { "type": "string", "nullable": true, "description": "Topic identifier (e.g. `P3_000001`)." },
          "name": { "type": "string", "nullable": true, "description": "Topic name (e.g. `Economic Policy`)." },
          "parent_id": { "type": "string", "nullable": true, "description": "Parent topic ID for hierarchical vocabularies." },
          "vocabulary": { "type": "string", "nullable": true, "description": "Source vocabulary (e.g. `WB Practice Groups`, `Data360 Topic L1`)." },
          "uri": { "type": "string", "nullable": true }
        }
      },
      "TimePeriod": {
        "type": "object",
        "properties": {
          "start": { "type": "string", "nullable": true, "description": "Start period (e.g. `1948` or `2010-Q1`)." },
          "end": { "type": "string", "nullable": true, "description": "End period." },
          "notes": { "type": "string", "nullable": true }
        }
      },
      "RefArea": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Country / region name." },
          "code": { "type": "string", "description": "ISO-3 country code (or other reference area code)." }
        }
      },
      "License": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "nullable": true },
          "uri": { "type": "string", "nullable": true },
          "note": { "type": "string", "nullable": true }
        }
      },
      "Source": {
        "type": "object",
        "description": "An external source from which the indicator data is drawn.",
        "properties": {
          "idno": { "type": "string", "nullable": true },
          "type": { "type": "string", "nullable": true },
          "name": { "type": "string", "nullable": true },
          "organization": { "type": "string", "nullable": true },
          "publisher": { "type": "string", "nullable": true },
          "publication_date": { "type": "string", "nullable": true },
          "uri": { "type": "string", "nullable": true },
          "access_date": { "type": "string", "nullable": true },
          "note": { "type": "string", "nullable": true },
          "other_identifiers": { "type": "array", "items": { "type": "object" } },
          "authors": { "type": "array", "items": { "type": "object" } },
          "datasets": { "type": "array", "items": { "type": "object" } }
        }
      },
      "Additional": {
        "type": "object",
        "description": "Auxiliary namespace for visualization and presentation hints.",
        "properties": {
          "metadata_link": {
            "type": "array",
            "items": { "type": "object" }
          },
          "visualization": { "$ref": "#/components/schemas/Visualization" }
        }
      },
      "Visualization": {
        "type": "object",
        "description": "Hints used by Data360 front-ends to render charts for this indicator.",
        "properties": {
          "scale_type": { "type": "string", "nullable": true },
          "legend_type": { "type": "string", "nullable": true },
          "axis_type": { "type": "string", "nullable": true },
          "notes": { "type": "string", "nullable": true },
          "axis_values": { "type": "string", "nullable": true },
          "axis_values_params": { "type": "string", "nullable": true },
          "display_name": { "type": "string", "nullable": true },
          "suppression": { "type": "string", "nullable": true },
          "temporal_default": { "type": "string", "nullable": true },
          "temporal_cutoff": { "type": "string", "nullable": true },
          "div_params": { "type": "array", "items": { "type": "object" } },
          "axis_type_params": { "type": "array", "items": { "type": "object" } },
          "bin_params": { "type": "array", "items": { "type": "object" } },
          "missing_data": { "type": "array", "items": { "type": "object" } },
          "chart_type": {
            "type": "array",
            "description": "Chart types recommended for this indicator.",
            "items": {
              "type": "object",
              "properties": {
                "chart_types": { "type": "string", "description": "Chart type name (e.g. `stackedBar`, `pie`, `line`)." }
              }
            }
          }
        }
      },
      "DisaggregationCode": {
        "type": "object",
        "description": "Codelist values available for a single disaggregation dimension on this indicator.",
        "properties": {
          "name": { "type": "string", "description": "Dimension name (e.g. `COMP_BREAKDOWN_1`)." },
          "value": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Allowed code values for the dimension."
          },
          "label_name": { "type": "string", "description": "Human-readable label of the dimension." }
        }
      }
    }
  }
}
