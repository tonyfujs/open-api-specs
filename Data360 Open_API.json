    "/data360/metadata": {
      "post": {
        "summary": "Metadata based on provided filters",
        "description": "Retrieves metadata documents matching an OData-style query.\n\n**Field access.** Use slash-paths to reach nested fields, e.g. `series_description/database_id`. The full set of accessible fields is documented in the `MetadataDocument` schema and its child schemas (`SeriesDescription`, `MetadataInformation`, `Additional`, etc.).\n\n**Common query patterns.** See the `$filter` and `$select` examples below; for the full syntax see the API description.\n\n**Response shape.** Documents are returned inside the standard `value` array envelope. The schema is `MetadataSearchResponse`.",
        "tags": [
          "Metadata"
        ],
        "requestBody": {
          "description": "A JSON object containing a single 'query' property with the raw OData-style search query string.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "The complete search query string. Supports `$filter`, `$select`, `$orderby`, and OData operators (`eq`, `and`, `or`, `any(...)`). Use slash-paths to reach nested fields. Example: `*&$filter=series_description/database_id eq 'WB_WDI'&$select=series_description/database_id,series_description/idno`."
                  }
                },
                "required": [
                  "query"
                ],
                "additionalProperties": false
              },
              "examples": {
                "example1": {
                  "summary": "Retrieve all metadata fields for a given indicator",
                  "value": {
                    "query": "&$filter=series_description/idno eq 'WB_WDI_SP_POP_TOTL'"
                  }
                },
                "example2": {
                  "summary": "Retrieve specific metadata fields for a given indicator",
                  "value": {
                    "query": "&$filter=series_description/idno eq 'WB_WDI_SP_POP_TOTL'&$select=series_description/database_id,series_description/idno"
                  }
                },
                "example3": {
                  "summary": "Retrieve specific metadata fields for all indicators in a given database",
                  "value": {
                    "query": "&$filter=series_description/database_id eq 'WB_WDI'&$select=series_description/database_id,series_description/idno"
                  }
                },
                "example4": {
                  "summary": "Filter on a nested array (topics) using any()",
                  "value": {
                    "query": "&$filter=series_description/topics/any(t: t/name eq 'Health') and type eq 'indicator'&$select=series_description/idno,series_description/name"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success. Returns the OData envelope with an array of metadata documents.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetadataSearchResponse"
                },
                "examples": {
                  "indicator": {
                    "summary": "Trimmed indicator response (full schema in MetadataDocument)",
                    "value": {
                      "@odata.context": "https://itsda-dataexp-prd.search.windows.net/indexes('data360-metadata-vector')/$metadata#docs(*)",
                      "@odata.count": 1,
                      "value": [
                        {
                          "id": "META_IMF_BOP_IFR_BP6",
                          "idno": "d5d4e0b6-363d-4f2c-a1c3-07fa18dd2ddd",
                          "type": "indicator",
                          "subtype": "timeseries",
                          "dsd_name": "DATA360",
                          "dsd_version": "1.2",
                          "metadata_information": {
                            "title": "Metadata for International investment position (IIP) (with fund record)",
                            "idno": "META_IMF_BOP_IFR_BP6"
                          },
                          "series_description": {
                            "idno": "IMF_BOP_IFR_BP6",
                            "name": "International Investment Position (IIP) (with Fund Record)",
                            "database_id": "IMF_BOP",
                            "database_name": "Balance of Payments (BOP) and International Investment Position (IIP)",
                            "periodicity": "Quarterly, Annual",
                            "csv_link": "https://data360files.worldbank.org/data360-data/data/IMF_BOP/IMF_BOP_IFR_BP6.csv"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data360/searchv2": {
      "post": {
        "summary": "Search function",
        "description": "Performs a vector/keyword search of the Data360 catalog.\n\n**Request body.** See `SearchQuerySchema` for the full set of parameters. The `select` and `filter` strings use the same slash-path / OData syntax as `/data360/metadata`.\n\n**Response shape.** Documents are returned inside the standard `value` array envelope. See `MetadataSearchResponse` and `MetadataDocument` for the full field list (over 100 fields across the `metadata_information`, `series_description`, `additional`, and `disaggregation_codes` namespaces).",
        "tags": [
          "Search"
        ],
        "requestBody": {
          "description": "Vector / keyword search query parameters. See SearchQuerySchema for all supported fields.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchQuerySchema"
              },
              "examples": {
                "minimal": {
                  "summary": "Simple keyword search",
                  "value": {
                    "count": true,
                    "select": "series_description/idno, series_description/name, series_description/database_id",
                    "search": "poverty",
                    "top": 10
                  }
                },
                "advanced": {
                  "summary": "Searching only for indicators tagged with a specific topic",
                  "value": {
                    "count": false,
                    "filter": "series_description/topics/any(t: t/name eq 'Health') and type eq 'indicator'",
                    "orderby": "series_description/name",
                    "select": "series_description/idno, series_description/name, series_description/database_id",
                    "search": "nutrition",
                    "top": 20,
                    "skip": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success. Returns the OData envelope with an array of metadata documents.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetadataSearchResponse"
                },
                "examples": {
                  "minimal": {
                    "summary": "Trimmed search response (full schema in MetadataDocument)",
                    "value": {
                      "@odata.context": "https://itsda-dataexp-prd.search.windows.net/indexes('data360-metadata-vector')/$metadata#docs(*)",
                      "@odata.count": 1,
                      "value": [
                        {
                          "@search.score": 1.0,
                          "id": "META_IMF_BOP_IFR_BP6",
                          "type": "indicator",
                          "subtype": "timeseries",
                          "series_description": {
                            "idno": "IMF_BOP_IFR_BP6",
                            "name": "International Investment Position (IIP) (with Fund Record)",
                            "database_id": "IMF_BOP"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
